# ---- Option A: Camunda 8 Run (local) ----
ZEEBE_GRPC_ADDRESS=grpc://localhost:26500
ZEEBE_REST_ADDRESS=http://localhost:8080
CAMUNDA_AUTH_STRATEGY=NONE

# ---- Option B: Camunda SaaS ----
# In Console: your cluster > API > Create new client (tick Zeebe), then copy the values it shows for:
# ZEEBE_GRPC_ADDRESS, ZEEBE_REST_ADDRESS, ZEEBE_CLIENT_ID, ZEEBE_CLIENT_SECRET, CAMUNDA_OAUTH_URL
# and add:  CAMUNDA_AUTH_STRATEGY=OAUTH

# Where the mock accounts/notification API runs (the workers call it directly)
MOCK_API_URL=http://localhost:4000
