<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:error id="Err_Accounts" name="Accounts API error" errorCode="ACCOUNTS_API_ERROR" />
  <bpmn:process xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="ScholarshipProcess" name="Scholarship disbursement" isExecutable="true">
    <bpmn:startEvent id="Start" name="Scholarship application submitted">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="scholarship-application-form" />
      </bpmn:extensionElements>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Extract" name="Extract details from the application">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="extract-application-details" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="DMN" name="Decide eligibility (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="scholarship_eligibility" resultVariable="eligibilityDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GwElig" name="Eligible?" default="f5">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub" name="Committee review">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=committeeDecision" target="committeeDecision" />
          <zeebe:output source="=chairRemarks" target="chairRemarks" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:startEvent id="SStart" name="Review started">
        <bpmn:outgoing>Flow_0hrqjtx</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="HOD" name="Endorse application (HOD)">
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="committee-step-form" />
          <zeebe:userTask />
          <zeebe:ioMapping>
            <zeebe:input source="=eligibilityDecision.scholarshipCategory" target="scholarshipCategory" />
            <zeebe:input source="=eligibilityDecision.scholarshipAmount" target="scholarshipAmount" />
            <zeebe:input source="=eligibilityDecision.decisionReason" target="decisionReason" />
            <zeebe:input source="=&#34;Endorse application (HOD)&#34;" target="stepTitle" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_04e60ba</bpmn:incoming>
        <bpmn:outgoing>s2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Chair" name="Committee chairperson">
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="chair-decision-form" />
          <zeebe:userTask />
          <zeebe:ioMapping>
            <zeebe:input source="=eligibilityDecision.scholarshipCategory" target="scholarshipCategory" />
            <zeebe:input source="=eligibilityDecision.scholarshipAmount" target="scholarshipAmount" />
            <zeebe:input source="=eligibilityDecision.decisionReason" target="decisionReason" />
            <zeebe:output source="=committeeDecision" target="committeeDecision" />
            <zeebe:output source="=chairRemarks" target="chairRemarks" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>s2</bpmn:incoming>
        <bpmn:outgoing>s3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="GwChair" name="Chair decision?" default="s5">
        <bpmn:incoming>s3</bpmn:incoming>
        <bpmn:outgoing>s5</bpmn:outgoing>
        <bpmn:outgoing>s6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="VC" name="Sign-off by Vice-Chancellor">
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="committee-step-form" />
          <zeebe:userTask />
          <zeebe:ioMapping>
            <zeebe:input source="=eligibilityDecision.scholarshipCategory" target="scholarshipCategory" />
            <zeebe:input source="=eligibilityDecision.scholarshipAmount" target="scholarshipAmount" />
            <zeebe:input source="=eligibilityDecision.decisionReason" target="decisionReason" />
            <zeebe:input source="=&#34;Sign-off by Vice-Chancellor&#34;" target="stepTitle" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>s6</bpmn:incoming>
        <bpmn:outgoing>Flow_1v1ccnn</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Merge">
        <bpmn:incoming>s5</bpmn:incoming>
        <bpmn:incoming>Flow_1srl65t</bpmn:incoming>
        <bpmn:outgoing>s8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SEnd" name="Decision recorded">
        <bpmn:incoming>s8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="s2" sourceRef="HOD" targetRef="Chair" />
      <bpmn:sequenceFlow id="s3" sourceRef="Chair" targetRef="GwChair" />
      <bpmn:sequenceFlow id="s5" name="Rejected" sourceRef="GwChair" targetRef="Merge" />
      <bpmn:sequenceFlow id="s6" name="Approved (needs VC)" sourceRef="GwChair" targetRef="VC">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "APPROVED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="s8" sourceRef="Merge" targetRef="SEnd" />
      <bpmn:userTask id="Activity_0x10378" name="Sign off by Chancellor">
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="committee-step-form" />
          <zeebe:userTask />
          <zeebe:ioMapping>
            <zeebe:input source="=eligibilityDecision.scholarshipCategory" target="scholarshipCategory" />
            <zeebe:input source="=eligibilityDecision.scholarshipAmount" target="scholarshipAmount" />
            <zeebe:input source="=eligibilityDecision.decisionReason" target="decisionReason" />
            <zeebe:input source="=&#34;Sign off by Chancellor&#34;" target="stepTitle" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1v1ccnn</bpmn:incoming>
        <bpmn:outgoing>Flow_1srl65t</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_1v1ccnn" sourceRef="VC" targetRef="Activity_0x10378" />
      <bpmn:sequenceFlow id="Flow_1srl65t" sourceRef="Activity_0x10378" targetRef="Merge" />
      <bpmn:userTask id="Activity_0xiv2pn" name="FA and AA">
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="committee-step-form" />
          <zeebe:userTask />
          <zeebe:ioMapping>
            <zeebe:input source="=eligibilityDecision.scholarshipCategory" target="scholarshipCategory" />
            <zeebe:input source="=eligibilityDecision.scholarshipAmount" target="scholarshipAmount" />
            <zeebe:input source="=eligibilityDecision.decisionReason" target="decisionReason" />
            <zeebe:input source="=&#34;FA and AA&#34;" target="stepTitle" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0hrqjtx</bpmn:incoming>
        <bpmn:outgoing>Flow_04e60ba</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_04e60ba" sourceRef="Activity_0xiv2pn" targetRef="HOD" />
      <bpmn:sequenceFlow id="Flow_0hrqjtx" sourceRef="SStart" targetRef="Activity_0xiv2pn" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GwDec" name="Committee decision?" default="f9">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Post" name="Post disbursement request to accounts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://panda-stunner-nutmeg.ngrok-free.dev/api/disbursements&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;,&#10;&#34;ngrok-skip-browser-warning&#34;:&#34;true&#34;}" target="headers" />
          <zeebe:input source="={studentId: studentId, studentName: studentName, amount: eligibilityDecision.scholarshipAmount, category: eligibilityDecision.scholarshipCategory, approvedBy: &#34;Scholarship Committee&#34;, remarks: chairRemarks}" target="body" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={disbursementId: response.body.disbursementId, disbursementStatus: response.body.status, transactionRef: response.body.transactionRef}" />
          <zeebe:header key="errorExpression" value="=if is defined(error) then bpmnError(&#34;ACCOUNTS_API_ERROR&#34;, error.message) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NotifyAppr" name="Notify student: the approval and the disbursed amount">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="APPROVED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndDisb" name="Scholarship disbursed">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="NotifyNE" name="Notify student: not eligible">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="INELIGIBLE" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndInel" name="Application ineligible">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="NotifyRej" name="Notify student: rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="REJECTED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Remind" name="Remind committee chair">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://panda-stunner-nutmeg.ngrok-free.dev&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={to: &#34;scholarship.chair@university.example&#34;, type: &#34;COMMITTEE_REMINDER&#34;, subject: &#34;Reminder - scholarship application awaiting review&#34;, message: &#34;Application &#34; + studentId + &#34; (&#34; + studentName + &#34;) has been waiting for committee review for 48 hours.&#34;}" target="body" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndRem" name="Reminder sent">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer" name="48 h without review" cancelActivity="false" attachedToRef="Sub">
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err" name="Accounts API error" attachedToRef="Post">
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Err_Accounts" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Resolve" name="Resolve disbursement failure">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="disbursement-failure-form" />
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:input source="=eligibilityDecision.scholarshipAmount" target="scholarshipAmount" />
          <zeebe:output source="=retryDisbursement" target="retryDisbursement" />
          <zeebe:output source="=accountsRemarks" target="accountsRemarks" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwRetry" name="Retry disbursement?" default="f18">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="NotifyDel" name="Notify student: disbursement delayed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="notificationType" value="DISBURSEMENT_DELAYED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEsc" name="Escalated to manual disbursement">
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Extract" />
    <bpmn:sequenceFlow id="f2" sourceRef="Extract" targetRef="DMN" />
    <bpmn:sequenceFlow id="f3" sourceRef="DMN" targetRef="GwElig" />
    <bpmn:sequenceFlow id="f4" name="Eligible" sourceRef="GwElig" targetRef="Sub">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= eligibilityDecision.eligibility = "Eligible"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" name="Ineligible" sourceRef="GwElig" targetRef="NotifyNE" />
    <bpmn:sequenceFlow id="f6" sourceRef="NotifyNE" targetRef="EndInel" />
    <bpmn:sequenceFlow id="f7" sourceRef="Sub" targetRef="GwDec" />
    <bpmn:sequenceFlow id="f8" name="Approved" sourceRef="GwDec" targetRef="Post">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" name="Rejected" sourceRef="GwDec" targetRef="NotifyRej" />
    <bpmn:sequenceFlow id="f11" sourceRef="Post" targetRef="NotifyAppr" />
    <bpmn:sequenceFlow id="f12" sourceRef="NotifyAppr" targetRef="EndDisb" />
    <bpmn:sequenceFlow id="f13" sourceRef="Timer" targetRef="Remind" />
    <bpmn:sequenceFlow id="f14" sourceRef="Remind" targetRef="EndRem" />
    <bpmn:sequenceFlow id="f15" sourceRef="Err" targetRef="Resolve" />
    <bpmn:sequenceFlow id="f16" sourceRef="Resolve" targetRef="GwRetry" />
    <bpmn:sequenceFlow id="f17" name="Retry Unsuccesful" sourceRef="GwRetry" targetRef="Post">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryDisbursement = "RETRY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" name="Retry Successful" sourceRef="GwRetry" targetRef="NotifyDel" />
    <bpmn:sequenceFlow id="f19" sourceRef="NotifyDel" targetRef="EndEsc" />
    <bpmn:sequenceFlow id="f10" sourceRef="NotifyRej" targetRef="EndRej" />
    <bpmn:endEvent id="EndRej" name="Application rejected">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="Pl1" bpmnElement="ScholarshipProcess">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="152" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="141" y="462" width="58" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Extract_di" bpmnElement="Extract">
        <dc:Bounds x="230" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DMN_di" bpmnElement="DMN">
        <dc:Bounds x="380" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwElig_di" bpmnElement="GwElig" isMarkerVisible="true">
        <dc:Bounds x="530" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="534" y="393" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_di" bpmnElement="Sub" isExpanded="true">
        <dc:Bounds x="640" y="240" width="1000" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SStart_di" bpmnElement="SStart">
        <dc:Bounds x="672" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="654" y="455" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HOD_di" bpmnElement="HOD">
        <dc:Bounds x="910" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Chair_di" bpmnElement="Chair">
        <dc:Bounds x="1050" y="390" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwChair_di" bpmnElement="GwChair" isMarkerVisible="true">
        <dc:Bounds x="1195" y="405" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1247" y="423" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="VC_di" bpmnElement="VC">
        <dc:Bounds x="1240" y="310" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_di" bpmnElement="Merge" isMarkerVisible="true">
        <dc:Bounds x="1485" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SEnd_di" bpmnElement="SEnd">
        <dc:Bounds x="1552" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1526" y="455" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0x10378_di" bpmnElement="Activity_0x10378">
        <dc:Bounds x="1380" y="310" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0xiv2pn_di" bpmnElement="Activity_0xiv2pn">
        <dc:Bounds x="760" y="390" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2">
        <di:waypoint x="1010" y="430" />
        <di:waypoint x="1050" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s3_di" bpmnElement="s3">
        <di:waypoint x="1150" y="430" />
        <di:waypoint x="1195" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s5_di" bpmnElement="s5">
        <di:waypoint x="1220" y="455" />
        <di:waypoint x="1220" y="520" />
        <di:waypoint x="1510" y="520" />
        <di:waypoint x="1510" y="455" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1168" y="483" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s6_di" bpmnElement="s6">
        <di:waypoint x="1220" y="405" />
        <di:waypoint x="1220" y="350" />
        <di:waypoint x="1240" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1166" y="357" width="54" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s8_di" bpmnElement="s8">
